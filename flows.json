    {
        "id": "9c315a7ba7fba86e",
        "type": "function",
        "z": "0517d83e1fc3fbbe",
        "name": "Traductor Modbus",
        "func": "const d = msg.payload;\nif (!d || !d.cmd) return null;\n\nif (d.cmd === 'marcha') {\n    node.send({ payload: { value: true, fc: 5, unitid: 1, address: 8, quantity: 1 } });\n    setTimeout(function () {\n        node.send({ payload: { value: false, fc: 5, unitid: 1, address: 8, quantity: 1 } });\n    }, 300);\n    return null;\n} else if (d.cmd === 'parada') {\n    return { payload: { value: !!d.val, fc: 5, unitid: 1, address: 9, quantity: 1 } };\n} else if (d.cmd === 'emergencia') {\n    return { payload: { value: !!d.val, fc: 5, unitid: 1, address: 10, quantity: 1 } };\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 500,
