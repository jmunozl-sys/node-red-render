    {
        "id": "9ddfe544018b91f7",
        "type": "ui_template",
        "z": "0517d83e1fc3fbbe",
        "group": "a1b2c3d4e5f60002",
        "name": "Estilo Minimalista",
        "order": 0,
        "width": 0,
        "height": 0,
        "format": "<style>\n    /* 1. Fondo general de la pantalla */\n    body,\n    md-content,\n    .nr-dashboard-theme {\n        background-color: #0b0f19 !important;\n        font-family: 'Segoe UI', Roboto, system-ui, sans-serif !important;\n    }\n\n    /* 2. Eliminación del recuadro blanco + Borde Fosforescente (Cyan Neón) */\n    ui-card-panel,\n    .nr-dashboard-cardpanel,\n    md-card,\n    .md-card,\n    .nr-dashboard-card {\n        background-color: #131b2e !important;\n        background: #131b2e !important;\n        border: 2px solid #00f3ff !important;\n        /* Borde cian fosforescente */\n        border-radius: 14px !important;\n        box-shadow: 0 0 15px rgba(0, 243, 255, 0.4), 0 10px 25px -5px rgba(0, 0, 0, 0.7) !important;\n        /* Resplandor neón */\n        padding: 18px 20px !important;\n    }\n\n    /* 3. Título del Panel (MANDO) */\n    .nr-dashboard-cardtitle,\n    md-card-title {\n        color: #00f3ff !important;\n        /* Texto fosforescente */\n        font-size: 14px !important;\n        font-weight: 800 !important;\n        letter-spacing: 1.5px !important;\n        text-transform: uppercase !important;\n        border-bottom: 1px solid rgba(0, 243, 255, 0.25) !important;\n        padding-bottom: 10px !important;\n        margin-bottom: 16px !important;\n        text-shadow: 0 0 8px rgba(0, 243, 255, 0.6) !important;\n    }\n\n    /* 4. Textos de Controles (MOTOR, PARADA, PARO DE EMERGENCIA) */\n    md-card-content,\n    label,\n    p,\n    span,\n    div,\n    .ui-led-label {\n        color: #f8fafc !important;\n        font-size: 13.5px !important;\n        font-weight: 600 !important;\n        letter-spacing: 0.3px !important;\n    }\n\n    /* 5. Transparencia de contenedores internos */\n    .ui-led-container,\n    .nr-dashboard-template,\n    div[ng-eval] {\n        background-color: transparent !important;\n    }\n\n    /* 6. Botón ENCENDER estilo Neón Verde */\n    .btn-minimal button,\n    md-button.md-raised {\n        background: linear-gradient(135deg, #00ff87 0%, #60efff 100%) !important;\n        border: none !important;\n        border-radius: 8px !important;\n        font-weight: 800 !important;\n        font-size: 14px !important;\n        letter-spacing: 1px !important;\n        color: #041019 !important;\n        min-height: 44px !important;\n        box-shadow: 0 0 12px rgba(0, 255, 135, 0.6) !important;\n        transition: all 0.2s ease-in-out !important;\n    }\n\n    .btn-minimal button:hover,\n    md-button.md-raised:hover {\n        box-shadow: 0 0 20px rgba(0, 255, 135, 0.9) !important;\n        transform: translateY(-1px) !important;\n    }\n\n    .btn-minimal button:active,\n    md-button.md-raised:active {\n        transform: translateY(1px) !important;\n    }\n\n    /* 7. Interruptores (Switches) fosforescentes */\n    md-switch .md-thumb {\n        background-color: #64748b !important;\n    }\n\n    md-switch.md-checked .md-thumb {\n        background-color: #00f3ff !important;\n        box-shadow: 0 0 10px #00f3ff !important;\n    }\n\n    md-switch.md-checked .md-bar {\n        background-color: rgba(0, 243, 255, 0.4) !important;\n    }\n</style>",
